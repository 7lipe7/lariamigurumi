{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "sh ./build.sh",
    "outputDirectory": ".",
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://xxbpmpemswfcefzjiqkv.supabase.co data:; font-src 'self'; connect-src 'self' https://xxbpmpemswfcefzjiqkv.supabase.co https://www.google-analytics.com https://*.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
                },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" }
            ]
        },
        {
            "source": "/img/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
            ]
        },
        {
            "source": "/style/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        },
        {
            "source": "/js/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        }
    ]
}
